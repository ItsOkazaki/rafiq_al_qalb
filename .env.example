# ─────────────────────────────────────────────────────────────────────────────
# رفيق القلوب — مثال متغيرات البيئة (انسخه إلى .env.local)
# كل المتغيرات اختيارية: التطبيق يعمل بالكامل بدون أي مفتاح عبر التنظيم الحتمي.
# لا تضع أي مفتاح حقيقي في Git — الأسرار تبقى في .env.local أو في متغيرات Vercel.
# ─────────────────────────────────────────────────────────────────────────────

# ── قاعدة بيانات تتبّع جلسات البحث (اختيارية تماماً) ─────────────────────────
# بدونها يعمل البحث كاملاً، ويتوقف تسجيل الجلسات فقط (فشل صامت مقصود).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ── مزوّد الذكاء الاصطناعي (اختياري — لتنظيم المقاطع المسترجعة فقط) ───────────
# AI_PROVIDER: gemini | openrouter | openai
# يُستنتج تلقائياً من المفتاح الموجود إن لم يُحدَّد.
# المزوّد المضبوط يُجرَّب أولاً؛ وإن فشل أو لم يُرجع نصاً يُنتقل إلى بقية
# المزوّدين التي تملك مفتاحاً (جميني ← أوبن راوتر ← أوبن إيه آي)، وكل ذلك
# ضمن مهلة AI_TIMEOUT_MS الإجمالية الواحدة المشتركة بين المحاولات.
# المفاتيح تُرسل في رؤوس الطلبات فقط ولا توضع في الروابط أبداً.
AI_PROVIDER=gemini

# Google Gemini (المزوّد الأساسي الموصى به — المفتاح في رأس x-goog-api-key)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# GEMINI_MODEL مُقبول أيضاً كاسم بديل لنموذج المحادثة.

# OpenRouter (موصول بالكامل: مسار أساسي عند اختياره أو وجود مفتاحه وحده،
# ومسار احتياط بعد جميني عند ضبطهما معاً)
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=qwen/qwen3.8-27b:free
# رؤوس الإسناد للوحات OpenRouter (قيم افتراضية معقولة عند تركها):
# OPENROUTER_SITE_URL=
# OPENROUTER_SITE_NAME=

# OpenAI (اختياري)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# مهلة إجمالية واحدة تتقاسمها كل محاولات المزوّدين في الطلب الواحد
# (بالمللي ثانية، الحد الأدنى ٣٠٠٠ = ٣ ثوانٍ)
AI_TIMEOUT_MS=20000

# ── الروابط المطلقة للصور الاجتماعية (اختياري) ───────────────────────────────
# تُضبط تلقائياً على Vercel عبر VERCEL_URL، وتُستخدم هنا للإعداد المحلي.
# NEXT_PUBLIC_SITE_URL=https://example.com

# ── أدوات الصيانة (لا تحتاجها لتشغيل التطبيق) ────────────────────────────────
# مفتاح Jina Reader يرفع حدود الاستدعاء أثناء سحب صفحات جامع السنة عند الحجب.
# JINA_API_KEY=

# للسماح لـingest باستبدال corpus أكبر بـcorpus أصغر (بعد التأكد يدوياً):
# ALLOW_CORPUS_SHRINK=1

# ── تحديد الطلبات: من أين يُقرأ عنوان العميل (اختياري) ────────────────────────
# الحد ٣٠ طلباً/دقيقة لكل عميل. حتى لا يكون اختيارياً، لا يُشتق مفتاح العميل من أي
# ترويسة يستطيع العميل كتابتها كما هي.
#
# على Vercel لا تضبط شيئاً: المنصة تعرف نفسها (VERCEL/VERCEL_ENV) وتكتب
# x-vercel-forwarded-for وx-real-ip بنفسها، فتُقرأ منهما.
#
# على استضافة ذاتية خلف وسيط تكتب الترويسات بنفسه (nginx مثلاً):
#   TRUST_PLATFORM_HEADERS=1
#   TRUSTED_PROXY_HOPS=1        # عدد الوكلاء الموثوقين بين العميل وبين التطبيق
# وبدون هذا الضبط لا تُقرأ أي ترويسة عنوان إطلاقاً، فيشترك كل العملاء في دلو واحد
# (تشديد لا تجاوز): آمن للمطور الواحد، وغير مناسب لخدمة متعددة المستخدمين.
# TRUST_PLATFORM_HEADERS=
# TRUSTED_PROXY_HOPS=
