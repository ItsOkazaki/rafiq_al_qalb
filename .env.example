# Required on Vercel: pooled PostgreSQL connection string from Neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# AI API Key (Recommended: Google Gemini or OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Defaults to gemini-1.5-flash if GEMINI_API_KEY is used
OPENAI_MODEL=
OPENAI_BASE_URL=
