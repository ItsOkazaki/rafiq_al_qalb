# ─────────────────────────────────────────────────────────────────────────────
# Rafiq Al-Qulub — AI provider configuration
# Free/no-billing development options are supported:
#   1) Gemini Developer API (recommended for this project)
#   2) OpenRouter free endpoints
# OpenAI remains supported for judges/team deployments that have API credit.
# Never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# Neon pooled PostgreSQL connection for operational telemetry/evaluation.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Choose the chat/reasoning provider: gemini | openrouter | openai
AI_PROVIDER=gemini

# Gemini Developer API (free-tier capable models; quotas/rate limits apply).
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# OpenRouter (free endpoints only in the default configuration).
# Free plan currently has a 50-request/day platform limit and free model routes
# can change availability. Keep :free on the selected model IDs.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free
OPENROUTER_SITE_URL=https://rafiq-alqulub.vercel.app
OPENROUTER_SITE_NAME=Rafiq Al-Qulub

# Optional: use a different provider just for embeddings.
# Leave unset to use the same provider selected by AI_PROVIDER.
EMBEDDING_PROVIDER=

# OpenAI (legacy/direct competition deployment; not required for free testing).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Backwards-compatible aliases.
AI_API_KEY=
AI_BASE_URL=
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=

AI_TIMEOUT_MS=20000
AI_RERANK_CANDIDATES=10
AI_FINAL_PASSAGES=4
