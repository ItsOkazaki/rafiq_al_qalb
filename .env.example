# ─────────────────────────────────────────────────────────────────────────────
# رفيق القلوب — مثال متغيرات البيئة (انسخه إلى .env.local)
# كل المتغيرات اختيارية: التطبيق يعمل بالكامل بدون أي مفتاح عبر التنظيم الحتمي.
# لا تضع أي مفتاح حقيقي في Git — الأسرار تبقى في .env.local أو في متغيرات Vercel.
# ─────────────────────────────────────────────────────────────────────────────

# ── قاعدة بيانات تتبّع جلسات البحث (اختيارية تماماً) ─────────────────────────
# بدونها يعمل البحث كاملاً، ويتوقف تسجيل الجلسات فقط (فشل صامت مقصود).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ── مزوّد الذكاء الاصطناعي (اختياري — لتنظيم المقاطع المسترجعة فقط) ───────────
# AI_PROVIDER: gemini | openrouter | openai
# يُستنتج تلقائياً من المفتاح الموجود إن لم يُحدَّد.
AI_PROVIDER=gemini

# Google Gemini (المزوّد الأساسي الموصى به)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# GEMINI_MODEL مُقبول أيضاً كاسم بديل لنموذج المحادثة.

# OpenRouter (اختياري)
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=qwen/qwen3.8-27b:free
# OPENROUTER_SITE_URL=
# OPENROUTER_SITE_NAME=

# OpenAI (اختياري)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# مهلة الطلبات للمزوّد (بالمللي ثانية، الحد الأدنى ٣٠٠٠ = ٣ ثوانٍ)
AI_TIMEOUT_MS=20000

# ── الروابط المطلقة للصور الاجتماعية (اختياري) ───────────────────────────────
# تُضبط تلقائياً على Vercel عبر VERCEL_URL، وتُستخدم هنا للإعداد المحلي.
# NEXT_PUBLIC_SITE_URL=https://example.com

# ── أدوات الصيانة (لا تحتاجها لتشغيل التطبيق) ────────────────────────────────
# مفتاح Jina Reader يرفع حدود الاستدعاء أثناء سحب صفحات جامع السنة عند الحجب.
# JINA_API_KEY=

# للسماح لـingest باستبدال corpus أكبر بـcorpus أصغر (بعد التأكد يدوياً):
# ALLOW_CORPUS_SHRINK=1
