# Required on Vercel: pooled PostgreSQL connection string from Neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional: enables AI organization grounded only in retrieved passages.
# Without this key, the deterministic retrieval organizer is used intentionally.
OPENAI_API_KEY=

# Optional — defaults shown; omit when using standard OpenAI.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
